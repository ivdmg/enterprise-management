# App Settings
PROJECT_NAME="Smart Enterprise Hub"
ENVIRONMENT="development"
DEBUG=true
ALLOW_REGISTRATION=true

# Database Settings (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_hub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_hub
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_hub

# Security & JWT (Set a strong 32+ char key in production)
JWT_SECRET=development_super_secret_jwt_key_enterprise_hub_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Storage Configuration (Path traversal protected)
STORAGE_DIR=storage/tenants
MAX_FILE_SIZE_BYTES=26214400

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# External Integrations (Optional)
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Google Drive: import existing XLSX/XLS files and native Google Sheets.
# setup_demo writes GOOGLE_DRIVE_COMPANY_ID and disables public registration.
GOOGLE_DRIVE_MOCK=false
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_COMPANY_ID=
SYNC_INTERVAL_SECONDS=120

# Customer workbook (copy the actual .env privately for the same deployment)
GOOGLE_DRIVE_SOURCE_FILE_ID=1SYlY2lmUHZaLdi5JiK6duwihi1zoMZuPbGzBx4UtfHk
